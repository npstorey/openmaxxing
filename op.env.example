# Copy to op.env (gitignored) and point each reference at your own 1Password item.
# The file holds references, never values: op run resolves them for one process.
#   op run --env-file=op.env -- npm run ask -- "<question>"
TINFOIL_API_KEY=op://<vault>/<tinfoil-item>/credential
TYPEDSTANDARDS_SIGNING_SEED_B64=op://<vault>/<signing-seed-item>/password
# Optional, for higher Socrata rate limits:
# SOCRATA_APP_TOKEN=op://<vault>/<socrata-item>/credential
